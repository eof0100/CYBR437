set pagination off
info functions main
checksec
set disassebly-flavor intel
disassemble mainz
cls
clear
set disassembly-flavor intel
disassemble main
break main
break simpleCounter
break simpleIf
run
set $base = (unsigned long)&main - 0x12a3
set $labbase = (unsigned long)&main - 0x12a3
info line *$pc
x/s $labbase+0x207c
x/s $labbase+0x206c
info breakpoints
delete 1
break cybr437lab2main.c:23
info breakpoints
continue
info args
backtrace
disassemble simpleCounter
p/x &VAR
p VAR
vmmap $1abbase+0x2068
vmmap $labbase+0x2068
continue
info args
backtrace
disassemble simpleIf
x/s $labbase+0x2008
whatis MAX
p MAX
p s
p/x &s
vmmap $labbase+0x4010
continue
info args
p s
x/64gx $rsp
ls
clear
exit
